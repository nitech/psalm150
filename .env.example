POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://psa150:replace-with-a-long-random-password@localhost:5432/psa150
PSA150_PORT=8080
PSA150_BIND=0.0.0.0:8080
PSA150_WEB_DIST=web/dist
PSA150_SESSION_HOURS=168
# Where song recordings are kept as files (Compose uses a volume at
# /app/data/media). Back it up together with the database.
PSA150_MEDIA_DIR=data/media
# Behind a reverse proxy, the header it sets to the client's address, so
# failed sign-ins are limited per client rather than for everyone at once.
# PSA150_CLIENT_IP_HEADER=X-Forwarded-For
RUST_LOG=psa150_server=info,tower_http=info
