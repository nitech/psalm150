{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praise",
  "version": "0.1.0",
  "identifier": "com.sevenfold.praise",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Praise",
        "width": 1280,
        "height": 900,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExODIzMERFRUQzNDQzREMKUldUY1F6VHQzakNDRWUzdFliRTI3azlmQ2trMUxBQ3o0cUhLdDF0R3E0VnYzTUxyd2NvTmVBNkMK",
      "endpoints": [
        "https://github.com/nitech/praise/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
