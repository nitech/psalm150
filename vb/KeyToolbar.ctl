VERSION 5.00

Begin VB.UserControl KeyToolbar
    ScaleMode = 1
    AutoRedraw = 0              'False
    FontTransparent = -1              'True
    ClientLeft   = 0
    ClientTop    = 0
    ClientWidth  = 4800
    ClientHeight = 1305
    Begin VB.PictureBox picBtn
        Index = 0
        Left   = 0
        Top    = 0
        Width  = 570
        Height = 510
        TabIndex = 0
        ScaleMode = 1
        AutoRedraw = 0              'False
        FontTransparent = -1              'True
    End
End
